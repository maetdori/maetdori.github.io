---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

type Props = { post: CollectionEntry<'posts'> };
const { post } = Astro.props;
const { Content, headings } = await post.render();
const d = post.data;
// 본문 h2/h3만 목차로 (Astro가 heading에 자동 부여한 slug 사용)
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
// 이전/다음 글 — 발행일 오름차순 기준. prev = 더 오래된 글, next = 더 최신 글.
const ordered = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf()
);
const here = ordered.findIndex((p) => p.slug === post.slug);
const prevPost = ordered[here - 1] ?? null;
const nextPost = ordered[here + 1] ?? null;
// 제목 길이로 h1 크기 동적 결정 — 짧으면 크게(최대 2.6rem), 길면 한 줄에 맞게 축소.
// 전각·ASCII·공백 가중치. (주의: Astro frontmatter엔 부등호 문자를 쓰지 말 것 — JSX로 오인됨)
const titleWide = (d.title.match(/[^\x00-\x7f]/g) || []).length;
const titleSpaces = (d.title.match(/\s/g) || []).length;
const titleNarrow = d.title.length - titleWide - titleSpaces;
const titleUnits = titleWide * 0.95 + titleNarrow * 0.5 + titleSpaces * 0.32;
const titleMaxPx = Math.max(30, Math.min(41.6, 640 / titleUnits));
const h1Style = `font-size: clamp(1.5rem, 6.5vw, ${titleMaxPx.toFixed(1)}px)`;
---

<Base title={`${d.title} — maetdori.log`} description={d.description} article>
  <nav class="nav">
    <div class="nav-inner">
      <a class="nav-brand" href="/">maetdori<span class="hl">.log</span></a>
      <div class="nav-links">
        <a href="/">글</a>
        <a href="https://github.com/maetdori" target="_blank" rel="noopener">GitHub ↗</a>
        <button id="theme-btn" class="nav-toggle" type="button" aria-label="테마 전환" title="테마 전환">
          <svg class="icon icon-moon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
          <svg class="icon icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.4 1.4M17.6 17.6 19 19M19 5l-1.4 1.4M6.4 17.6 5 19"></path></svg>
        </button>
      </div>
    </div>
  </nav>

  <article>
    <header class="art-hero">
      <a class="art-back" href="/">← 글 목록</a>
      <span class="eyebrow">{d.category}</span>
      <h1 style={h1Style}>{d.title}</h1>
      <div class="byline">
        <span>{d.date}</span>
      </div>
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>

  {
    toc.length > 1 && (
      <aside class="toc" aria-label="목차">
        <p class="toc-label">On this page</p>
        {toc.map((h) => (
          <a href={`#${h.slug}`} class:list={['toc-link', { sub: h.depth === 3 }]}>
            {h.text}
          </a>
        ))}
      </aside>
    )
  }

  {
    (prevPost || nextPost) && (
      <nav class="post-nav" aria-label="다른 글로 이동">
        {prevPost && (
          <a class="pnav prev" href={`/posts/${prevPost.slug}/`}>
            <span class="pnav-dir">← 이전 글</span>
            <span class="pnav-title">{prevPost.data.title}</span>
          </a>
        )}
        {nextPost && (
          <a class="pnav next" href={`/posts/${nextPost.slug}/`}>
            <span class="pnav-dir">다음 글 →</span>
            <span class="pnav-title">{nextPost.data.title}</span>
          </a>
        )}
      </nav>
    )
  }

  <div class="post-foot">
    <a class="back-link" href="/">← 다른 글 보러 가기</a>
  </div>

  <footer class="footer">
    <div class="wrap">
      <p>© {new Date().getFullYear()} 이해인 (maetdori)</p>
    </div>
  </footer>

  <script>
    // TOC 스크롤 스파이: 현재 보이는 섹션의 목차 링크를 강조
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a'));
    const map = new Map<string, HTMLAnchorElement>();
    links.forEach((a) => {
      const id = a.getAttribute('href')?.slice(1);
      const el = id ? document.getElementById(decodeURIComponent(id)) : null;
      if (el && id) map.set(decodeURIComponent(id), a);
    });
    if (map.size) {
      const spy = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              links.forEach((l) => l.classList.remove('active'));
              map.get(e.target.id)?.classList.add('active');
            }
          });
        },
        { rootMargin: '-40% 0px -55% 0px', threshold: 0 }
      );
      map.forEach((_, id) => {
        const el = document.getElementById(id);
        if (el) spy.observe(el);
      });
    }
  </script>
</Base>
