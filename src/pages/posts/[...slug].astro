---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

type Props = { post: CollectionEntry<'posts'> };
const { post } = Astro.props;
const { Content, headings } = await post.render();
const d = post.data;
// 본문 h2/h3만 목차로 (Astro가 heading에 자동 부여한 slug 사용)
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<Base title={`${d.title} — maetdori.log`} description={d.description} article>
  <nav class="nav">
    <div class="nav-inner">
      <a class="nav-brand" href="/">maetdori<span class="hl">.log</span></a>
      <div class="nav-links">
        <a href="/">글</a>
        <a href="https://github.com/maetdori" target="_blank" rel="noopener">GitHub ↗</a>
      </div>
    </div>
  </nav>

  <article>
    <header class="art-hero">
      <a class="art-back" href="/">← 글 목록</a>
      <span class="eyebrow">{d.category}</span>
      <h1>{d.title}</h1>
      <div class="byline">
        <span>{d.date}</span>
      </div>
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>

  {
    toc.length > 1 && (
      <aside class="toc" aria-label="목차">
        <p class="toc-label">On this page</p>
        {toc.map((h) => (
          <a href={`#${h.slug}`} class:list={['toc-link', { sub: h.depth === 3 }]}>
            {h.text}
          </a>
        ))}
      </aside>
    )
  }

  <div class="post-foot">
    <a class="back-link" href="/">← 다른 글 보러 가기</a>
  </div>

  <footer class="footer">
    <div class="wrap">
      <p>© {new Date().getFullYear()} 이해인 (maetdori) · Built with Astro</p>
    </div>
  </footer>

  <script>
    // TOC 스크롤 스파이: 현재 보이는 섹션의 목차 링크를 강조
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a'));
    const map = new Map<string, HTMLAnchorElement>();
    links.forEach((a) => {
      const id = a.getAttribute('href')?.slice(1);
      const el = id ? document.getElementById(decodeURIComponent(id)) : null;
      if (el && id) map.set(decodeURIComponent(id), a);
    });
    if (map.size) {
      const spy = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              links.forEach((l) => l.classList.remove('active'));
              map.get(e.target.id)?.classList.add('active');
            }
          });
        },
        { rootMargin: '-40% 0px -55% 0px', threshold: 0 }
      );
      map.forEach((_, id) => {
        const el = document.getElementById(id);
        if (el) spy.observe(el);
      });
    }
  </script>
</Base>
