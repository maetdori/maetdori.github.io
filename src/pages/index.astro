---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const years = posts.map((p) => p.data.pubDate.getFullYear());
const since = Math.min(...years);
---

<Base
  title="maetdori.log — 이해인 기술 블로그"
  description="백엔드를 파다가 가끔 픽셀도 찍습니다. 오래 붙잡았던 문제와 그때의 기록."
>
  <nav class="nav">
    <div class="nav-inner">
      <a class="nav-brand" href="/">maetdori<span class="hl">.log</span></a>
      <div class="nav-links">
        <a href="/" class="active">글</a>
        <a href="https://portfolio.minijihob.workers.dev" target="_blank" rel="noopener">Portfolio ↗</a>
        <a href="https://github.com/maetdori" target="_blank" rel="noopener">GitHub ↗</a>
      </div>
    </div>
  </nav>

  <div class="wrap">
    <header class="mast">
      <p class="eyebrow">~/writing</p>
      <h1>오래 붙잡았던 문제와<br />그때의 <span class="hl">기록</span>.</h1>
      <p class="tagline">백엔드를 파다가 가끔 픽셀도 찍습니다. 이해인(maetdori)의 기술 블로그입니다.</p>
      <div class="stats">
        <span><b>{posts.length}</b> posts</span>
        <span><b>{since}</b> — now</span>
        <span>Backend · Java · Side Project</span>
      </div>
    </header>
  </div>

  <section class="writing-section">
    <div class="wrap">
      <p class="section-title">Technical Writing</p>
      <div class="writing-grid">
        {
          posts.map((post) => (
            <a class="writing-card" href={`/posts/${post.slug}/`}>
              <span class="writing-card-thumb">
                {post.data.thumb && <img src={post.data.thumb} alt="" loading="lazy" />}
              </span>
              <span class="writing-card-body">
                <span class="writing-card-date">{post.data.date}</span>
                <span class="writing-card-title">{post.data.title}</span>
                <span class="writing-card-tags">
                  {post.data.tags.slice(0, 2).map((t) => (
                    <span class="wt">{t}</span>
                  ))}
                </span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <footer class="footer">
    <div class="wrap">
      <p>© {new Date().getFullYear()} 이해인 (maetdori) · Built with Astro</p>
    </div>
  </footer>
</Base>
