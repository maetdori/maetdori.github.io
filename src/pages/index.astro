---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// 사이드 프로젝트. 각 항목은 자체 라이브 페이지로 링크. 새 프로젝트는 여기 추가.
const projects = [
  {
    title: '클로도치 (claudotchi)',
    description:
      'AI를 어떻게 쓰는지에 따라 자라는 Claude Code 펫. 컨텍스트 사용량이 곧 수명이라, 상태표시줄의 픽셀 클로드만 봐도 내가 컨텍스트를 얼마나 썼는지 한눈에 보입니다.',
    eyebrow: 'Claude Code · 플러그인',
    thumb: '/projects/claudotchi.svg',
    href: 'https://maetdori.github.io/claudotchi/',
    external: true,
  },
];
---

<Base title="maetdori.log">
  <nav class="nav">
    <div class="nav-inner">
      <a class="nav-brand" href="/">maetdori<span class="hl">.log</span></a>
      <div class="nav-links">
        <a href="/" class="active">글</a>
        <a href="https://github.com/maetdori" target="_blank" rel="noopener">GitHub ↗</a>
        <button id="theme-btn" class="nav-toggle" type="button" aria-label="테마 전환" title="테마 전환">
          <svg class="icon icon-moon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
          <svg class="icon icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.4 1.4M17.6 17.6 19 19M19 5l-1.4 1.4M6.4 17.6 5 19"></path></svg>
        </button>
      </div>
    </div>
  </nav>

  <!-- 상단: 기술 포스트 -->
  <section class="home-section first">
    <div class="wrap">
      <p class="section-title">Technical Writing</p>
      <div class="writing-grid">
        {
          posts.map((post) => (
            <a class="writing-card" href={`/posts/${post.slug}/`}>
              <span class="writing-card-thumb">
                {post.data.thumb && <img src={post.data.thumb} alt="" loading="lazy" />}
              </span>
              <span class="writing-card-body">
                <span class="writing-card-date">{post.data.date}</span>
                <span class="writing-card-title">{post.data.title}</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 하단: 프로젝트 -->
  <section class="home-section last">
    <div class="wrap">
      <p class="section-title">Playground</p>
      {
        projects.map((p) => (
          <a
            class="project-card"
            href={p.href}
            target={p.external ? '_blank' : undefined}
            rel={p.external ? 'noopener' : undefined}
          >
            <span class="project-thumb">
              {p.thumb && <img src={p.thumb} alt="" loading="lazy" />}
            </span>
            <span class="project-body">
              <span class="project-eyebrow">{p.eyebrow}{p.external ? ' ↗' : ''}</span>
              <span class="project-title">{p.title}</span>
              <span class="project-desc">{p.description}</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <footer class="footer">
    <div class="wrap">
      <p>© {new Date().getFullYear()} 이해인 (maetdori)</p>
    </div>
  </footer>
</Base>
